{
  "name": "bc-election-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node build.js",
    "build:static": "node build.js",
    "dev": "node build.js --watch",
    "preview": "python3 -m http.server 8080 --directory dist-static",
    "format": "prettier --write build.js \"scripts/**/*.mjs\" \"src/**/*.{js,jsx,css}\" \"tests/**/*.{js,mjs}\" index.html README.md",
    "format:check": "prettier --check build.js \"scripts/**/*.mjs\" \"src/**/*.{js,jsx,css}\" \"tests/**/*.{js,mjs}\" index.html README.md",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser/run.mjs",
    "test:browser:static": "node tests/browser/run.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "prettier": "3.9.9"
  }
}
